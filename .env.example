# TPD HQ configuration template. Copy what you need; never commit real values.
#
# ── PUBLIC (built into the website; safe to expose by design) ──────────────────
# Supabase project URL and anon key. The anon key only allows what row-level
# security permits (see supabase/migrations). Set as GitHub Actions/Pages build env.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase anon key>
# Department AnchorCAD panel (must be https on anchorcad.xyz or anchr.gg).
NEXT_PUBLIC_ANCHORCAD_URL=https://anchorcad.xyz/<your panel path>

# ── SECRETS (Supabase Edge Function secrets only: `supabase secrets set ...`) ────
# Never put these in NEXT_PUBLIC_* variables, the repository, or the browser.
SUPABASE_URL=https://<project-ref>.supabase.co          # provided automatically to Edge Functions
SUPABASE_ANON_KEY=<anon key>                               # provided automatically to Edge Functions
SUPABASE_SERVICE_ROLE_KEY=<service role key>               # provided automatically to Edge Functions
ALLOWED_ORIGINS=https://dedeworld9-cmd.github.io           # CORS origins allowed to call the functions

# Discord application (OAuth). Configured in Supabase Auth → Providers → Discord,
# and in supabase/config.toml for local development.
DISCORD_CLIENT_ID=<discord application id>
DISCORD_CLIENT_SECRET=<discord client secret>

# TPD Discord server ID. No bot: each member's own sign-in token (scope
# guilds.members.read) is used once, server-side, to read their own membership.
DISCORD_GUILD_ID=<TPD server id>

# Google Sheets roster (read-only service account; share the sheet with its email as Viewer).
GOOGLE_SHEETS_ID=1uWDH1g8BBlHDzzGaAvNH4FmQllbBtnjLPl-NtzdU0Zk
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=<entire service-account JSON on one line>

# Scheduled roster sync: shared secret sent by the scheduler in x-sync-secret.
ROSTER_SYNC_SECRET=<long random string>

# Internal Affairs intake: HMAC pepper for rate-limit keys (>= 32 random chars). Required, or intake returns 503.
IA_INTAKE_PEPPER=<openssl rand -base64 48>
# Cloudflare Turnstile secret. Leave UNSET until the form renders the Turnstile widget, or every complaint is rejected.
TURNSTILE_SECRET=<turnstile secret>

# AnchorCAD Open Developer API (optional; Dashboard → Config → Developer API, scope server:read).
ANCHORCAD_API_KEY=<ank_v1.serverId.secret>
ANCHORCAD_PANEL_URL=https://anchorcad.xyz/<your panel path>
